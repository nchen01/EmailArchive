# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual secrets.
#
# ── Voyage AI ─────────────────────────────────────────────────────────────────
# Required only when running embed_backfill.py (without --dry-run) or the live
# Voyage integration test.  ALL other tests use FakeEmbedClient and do not
# need this key.
#
# AUTHORIZATION: do not run any code that calls the Voyage API without the
# repo owner's explicit instruction for that specific run.
VOYAGE_API_KEY=your-voyage-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to the Docker Compose dev DB when unset; set here for a different
# target (e.g. a staging database).
# DATABASE_URL=postgresql+psycopg2://ekc:ekc_dev_password@localhost:5432/ekc_dev

# ── Auth mode (S22 — auth + tenant boundary) ──────────────────────────────────
# Controls the creator/mailbox authorization layer (docs/s19-auth-tenant-boundary-plan.md).
#   AUTH_MODE=dev         : local/demo mode. A fixed dev principal owns local/demo
#                           mailboxes, so typing a mailbox id and loading it works
#                           without login. Raw mailbox-id loading is allowed ONLY here.
#   AUTH_MODE=production  : (also the default when unset/unknown) every creator/
#                           mailbox route requires an authenticated principal. No
#                           login is wired yet, so production currently fails closed.
# scripts/run_backend.ps1 defaults this to `dev` for the local launcher.
# AUTH_MODE=dev

# ── Gmail OAuth + token vault (S23) ───────────────────────────────────────────
# Confidential web-app OAuth client for the production Gmail connect flow
# (docs/s20-oauth-token-vault-plan.md). The client secret is used only server-side
# for the token exchange and is never sent to the frontend or written to the DB.
# Unset in local/dev demos (which use AUTH_MODE=dev + the GMAIL_TOKEN path below).
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/gmail/callback
#
# S23 ships a DEV/TEST-ONLY in-process token vault (services/oauth/vault.py). It
# refuses to run unless AUTH_MODE=dev or EKC_ALLOW_DEV_VAULT=1; a production
# deployment must supply a KMS/secrets-manager-backed vault instead.
# EKC_ALLOW_DEV_VAULT=1
#
# Local/dev Gmail token (D6) — the AUTH_MODE=dev ingest path; never a production
# credential source. Prefer GMAIL_TOKEN_<mailbox_id> for a specific mailbox.
# GMAIL_TOKEN=your-local-gmail-token-json

# ── Optional feature flags ────────────────────────────────────────────────────
# Set to exactly "1" to activate the Voyage reranker in hybrid_search.
# Any other value (including "0", "false", "true") is treated as disabled.
# ENABLE_RERANKING=1
